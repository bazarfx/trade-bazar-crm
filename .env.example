# ── Postgres ─────────────────────────────────────────────────────────────
# Runtime (Next.js + BullMQ worker). Both are long-lived processes, so they
# want a real pool — never connection_limit=1, which serialises every query.
#
# Supabase: use Supavisor SESSION mode (port 5432 on the *pooler* host).
#   Copy the host VERBATIM from Dashboard -> Connect. Do not hand-assemble
#   an "aws-0-" prefix; newer projects are issued different ones.
#   Transaction mode (6543) buys nothing here and costs prepared statements.
# Vultr later: same value as DIRECT_URL.
DATABASE_URL="postgresql://crm:crm@localhost:5432/trade_bazar_crm?schema=public"

# Prisma CLI ONLY — migrate, db pull, studio. Never read at runtime.
#   Supabase: the SAME session-mode pooler host, port 5432.
#     NEVER db.<ref>.supabase.co — IPv6-only unless the IPv4 add-on is bought.
#     NEVER port 6543 — transaction mode cannot hold prisma's advisory lock.
#   Local and Vultr: identical to DATABASE_URL.
DIRECT_URL="postgresql://crm:crm@localhost:5432/trade_bazar_crm?schema=public"

REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

ARK_WEBHOOK_SECRET="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# A bare username at login expands to <username>@<this domain>
LOGIN_DEFAULT_DOMAIN="tradebazar.local"

# ── Seeding ──────────────────────────────────────────────────────────────
# Required against any non-localhost database. The seed refuses to fall back
# to its built-in default password when the target is remote.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
