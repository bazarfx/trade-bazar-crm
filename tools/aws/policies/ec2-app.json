{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": [
        "arn:aws:ssm:ap-south-1:010539085833:parameter/crm/test",
        "arn:aws:ssm:ap-south-1:010539085833:parameter/crm/test/*"
      ]
    },
    {
      "Sid": "ReadDeployBundle",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::crm-test-deploy-010539085833/*"
    }
  ]
}
