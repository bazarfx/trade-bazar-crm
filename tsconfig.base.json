{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "composite": true,
    "paths": {
      "@crm/shared": ["./packages/shared/src/index.ts"],
      "@crm/shared/*": ["./packages/shared/src/*"],
      "@crm/core": ["./packages/core/src/index.ts"],
      "@crm/core/*": ["./packages/core/src/*"],
      "@crm/db": ["./packages/db/src/index.ts"],
      "@crm/records": ["./packages/records/src/index.ts"],
      "@crm/records/*": ["./packages/records/src/*"]
    },
    "baseUrl": "."
  }
}
